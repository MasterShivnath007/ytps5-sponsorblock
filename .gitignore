# Retail app packages / test data (never commit)
3YOUTUBE-PS5/
*.pkg
*.PKG

# Locally downloaded PS5 payload SDK (~700 MB, fetched by scripts/setup_sdk.sh)
third_party/ps5-sdk/

# Build output
build/
*.o
*.a.tmp
logs/
__pycache__/
.DS_Store

# Generated headers (regenerated by make)
injector/hook_blob.h
module/payload_js.h

# Local release artifacts
dist/
*.zip

# Personal screenshots / media (never commit)
*.heic
*.HEIC
*.jpg
*.jpeg
*.png
# Website assets are the exception
!docs/*.png

# Generated direct-hook / embedded headers
injector/direct_hook_blob.h
injector/embedded_blobs.h
